msgid "Informe uma URL válida (ex.: https://exemplo.com/feed.xml)."
msgstr "Введите корректный URL (напр.: https://example.com/feed.xml)."

#: contents/ui/configGeneral.qml
msgid "Esse feed já foi adicionado."
msgstr "Этот канал уже добавлен."

#: contents/ui/configGeneral.qml
msgid "Adicionar feed RSS"
msgstr "Добавить RSS-канал"

#: contents/ui/configGeneral.qml
msgid "URL do feed (RSS ou Atom)…"
msgstr "URL канала (RSS или Atom)…"

#: contents/ui/configGeneral.qml
msgid "Limpar"
msgstr "Очистить"

#: contents/ui/configGeneral.qml
msgid "Adicionar"
msgstr "Добавить"

#: contents/ui/configGeneral.qml
msgid "Testando…"
msgstr "Проверка…"

#: contents/ui/configGeneral.qml
msgid "Testar"
msgstr "Проверить"

#: contents/ui/configGeneral.qml
msgid "Seus feeds (%1)"
msgstr "Ваши каналы (%1)"

#: contents/ui/configGeneral.qml
msgid "Atualizar"
msgstr "Обновить"

#: contents/ui/configGeneral.qml
msgid "Atualização automática dos feeds"
msgstr "Автоматическое обновление каналов"

#: contents/ui/configGeneral.qml
msgid "Nenhum feed adicionado. Cole a URL de um feed no campo acima e clique em “Adicionar”."
msgstr "Каналы не добавлены. Вставьте URL канала в поле выше и нажмите «Добавить»."

#: contents/ui/configGeneral.qml
msgid "Remover feed"
msgstr "Удалить канал"

#: contents/ui/configGeneral.qml
msgid "Limite de notícias deste feed:"
msgstr "Лимит новостей этого канала:"

#: contents/ui/configGeneral.qml
msgid "notícias"
msgstr "новостей"

#: contents/ui/configGeneral.qml
msgid "O limite total de notícias da lista está na seção “Exibição”. As alterações são aplicadas imediatamente."
msgstr "Общий лимит новостей списка находится в разделе «Отображение». Изменения применяются немедленно."

#: contents/ui/configView.qml
msgid "Escolher ícone"
msgstr "Выбрать значок"

#: contents/ui/configView.qml
msgid "Imagens (*.png *.jpg *.jpeg *.svg *.webp *.bmp)"
msgstr "Изображения (*.png *.jpg *.jpeg *.svg *.webp *.bmp)"

#: contents/ui/configView.qml
msgid "Todos os arquivos (*)"
msgstr "Все файлы (*)"

#: contents/ui/configView.qml
msgid "Exibição"
msgstr "Отображение"

#: contents/ui/configView.qml
msgid "Máximo total de notícias na lista:"
msgstr "Максимум новостей в списке:"

#: contents/ui/configView.qml
msgid "Linhas da chamada da matéria:"
msgstr "Строки заголовка новости:"

#: contents/ui/configView.qml
msgid "linhas por notícia"
msgstr "строк на новость"

#: contents/ui/configView.qml
msgid "Colunas de notícias:"
msgstr "Колонки новостей:"

#: contents/ui/configView.qml
msgid "colunas no widget"
msgstr "колонок в виджете"

#: contents/ui/configView.qml
msgid "Com mais de 1 coluna, as notícias são distribuídas automaticamente entre as colunas."
msgstr "При более чем 1 колонке новости автоматически распределяются по колонкам."

#: contents/ui/configView.qml
msgid "Este limite vale para a lista inteira, somando todos os feeds. Para ajustar cada fonte individualmente, use a seção “Feeds de notícias”."
msgstr "Этот лимит действует для всего списка с учётом всех каналов. Чтобы настроить каждый источник отдельно, используйте раздел «Новостные каналы»."

#: contents/ui/configView.qml
msgid "As alterações são aplicadas imediatamente ao widget."
msgstr "Изменения немедленно применяются к виджету."

#: contents/ui/configView.qml
msgid "Ícone do widget"
msgstr "Значок виджета"

#: contents/ui/configView.qml
msgid "Este ícone aparece na barra de tarefas e no próprio widget."
msgstr "Этот значок отображается на панели задач и в самом виджете."

#: contents/ui/configView.qml
msgid "Usar padrão"
msgstr "Использовать по умолчанию"

#: contents/ui/configView.qml
msgid "Carregar arquivo próprio…"
msgstr "Загрузить свой файл…"

#: contents/ui/configView.qml
msgid "Use uma imagem (PNG, SVG, JPG…) do seu computador como ícone."
msgstr "Используйте изображение (PNG, SVG, JPG…) с компьютера в качестве значка."

#: contents/ui/configView.qml
msgid "Ícone próprio em uso:\n%1"
msgstr "Используется свой значок:\n%1"

#: contents/ui/configView.qml
msgid "Remover arquivo"
msgstr "Удалить файл"

#: contents/ui/configView.qml
msgid "Digite o nome de um ícone…"
msgstr "Введите имя значка…"

#: contents/ui/configView.qml
msgid "Escolha um dos ícones acima, digite o nome de qualquer ícone do tema (ex.: rss, internet-mail, text-html) ou carregue um arquivo próprio."
msgstr "Выберите один из значков выше, введите имя любого значка темы (напр.: rss, internet-mail, text-html) или загрузите свой файл."

#: contents/ui/main.qml

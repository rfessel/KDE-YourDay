#: contents/ui/configGeneral.qml
msgid "Informe uma URL válida (ex.: https://exemplo.com/feed.xml)."
msgstr "הזן כתובת URL תקפה (למשל: https://example.com/feed.xml)."

#: contents/ui/configGeneral.qml
msgid "Esse feed já foi adicionado."
msgstr "ערוץ זה כבר נוסף."

#: contents/ui/configGeneral.qml
msgid "Adicionar feed RSS"
msgstr "הוסף ערוץ RSS"

#: contents/ui/configGeneral.qml
msgid "URL do feed (RSS ou Atom)…"
msgstr "כתובת URL של הערוץ (RSS או Atom)…"

#: contents/ui/configGeneral.qml
msgid "Limpar"
msgstr "נקה"

#: contents/ui/configGeneral.qml
msgid "Adicionar"
msgstr "הוסף"

#: contents/ui/configGeneral.qml
msgid "Testando…"
msgstr "בודק…"

#: contents/ui/configGeneral.qml
msgid "Testar"
msgstr "בדוק"

#: contents/ui/configGeneral.qml
msgid "Seus feeds (%1)"
msgstr "הערוצים שלך (%1)"

#: contents/ui/configGeneral.qml
msgid "Atualizar"
msgstr "עדכן"

#: contents/ui/configGeneral.qml
msgid "Atualização automática dos feeds"
msgstr "עדכון אוטומטי של הערוצים"

#: contents/ui/configGeneral.qml
msgid "Nenhum feed adicionado. Cole a URL de um feed no campo acima e clique em “Adicionar”."
msgstr "לא נוסף ערוץ. הדבק כתובת URL של ערוץ בשדה למעלה ולחץ על «הוסף»."

#: contents/ui/configGeneral.qml
msgid "Remover feed"
msgstr "הסר ערוץ"

#: contents/ui/configGeneral.qml
msgid "Limite de notícias deste feed:"
msgstr "מגבלת חדשות של ערוץ זה:"

#: contents/ui/configGeneral.qml
msgid "notícias"
msgstr "חדשות"

#: contents/ui/configGeneral.qml
msgid "O limite total de notícias da lista está na seção “Exibição”. As alterações são aplicadas imediatamente."
msgstr "מגבלת החדשות הכוללת של הרשימה נמצאת בסעיף «תצוגה». השינויים מוחלים מיד."

#: contents/ui/configView.qml
msgid "Escolher ícone"
msgstr "בחר סמל"

#: contents/ui/configView.qml
msgid "Imagens (*.png *.jpg *.jpeg *.svg *.webp *.bmp)"
msgstr "תמונות (*.png *.jpg *.jpeg *.svg *.webp *.bmp)"

#: contents/ui/configView.qml
msgid "Todos os arquivos (*)"
msgstr "כל הקבצים (*)"

#: contents/ui/configView.qml
msgid "Exibição"
msgstr "תצוגה"

#: contents/ui/configView.qml
msgid "Máximo total de notícias na lista:"
msgstr "מקסימום חדשות ברשימה:"

#: contents/ui/configView.qml
msgid "Linhas da chamada da matéria:"
msgstr "שורות של כותרת הכתבה:"

#: contents/ui/configView.qml
msgid "linhas por notícia"
msgstr "שורות לחדשה"

#: contents/ui/configView.qml
msgid "Colunas de notícias:"
msgstr "עמודות חדשות:"

#: contents/ui/configView.qml
msgid "colunas no widget"
msgstr "עמודות בווידג'ט"

#: contents/ui/configView.qml
msgid "Com mais de 1 coluna, as notícias são distribuídas automaticamente entre as colunas."
msgstr "עם יותר מעמודה אחת, החדשות מחולקות אוטומטית בין העמודות."

#: contents/ui/configView.qml
msgid "Este limite vale para a lista inteira, somando todos os feeds. Para ajustar cada fonte individualmente, use a seção “Feeds de notícias”."
msgstr "מגבלה זו חלה על כל הרשימה, בסיכום כל הערוצים. כדי להתאים כל מקור בנפרד, השתמש בסעיף «ערוצי חדשות»."

#: contents/ui/configView.qml
msgid "As alterações são aplicadas imediatamente ao widget."
msgstr "השינויים חלים על הווידג'ט מיד."

#: contents/ui/configView.qml
msgid "Ícone do widget"
msgstr "סמל הווידג'ט"

#: contents/ui/configView.qml
msgid "Este ícone aparece na barra de tarefas e no próprio widget."
msgstr "סמל זה מופיע בשורת המשימות ובווידג'ט עצמו."

#: contents/ui/configView.qml
msgid "Usar padrão"
msgstr "השתמש בברירת מחדל"

#: contents/ui/configView.qml
msgid "Carregar arquivo próprio…"
msgstr "טען קובץ משלי…"

#: contents/ui/configView.qml
msgid "Use uma imagem (PNG, SVG, JPG…) do seu computador como ícone."
msgstr "השתמש בתמונה (PNG, SVG, JPG…) מהמחשב שלך כסמל."

#: contents/ui/configView.qml
msgid "Ícone próprio em uso:\n%1"
msgstr "נעשה שימוש בסמל משלי:\n%1"

#: contents/ui/configView.qml
msgid "Remover arquivo"
msgstr "הסר קובץ"

#: contents/ui/configView.qml
msgid "Digite o nome de um ícone…"
msgstr "הקלד שם של סמל…"

#: contents/ui/configView.qml
msgid "Escolha um dos ícones acima, digite o nome de qualquer ícone do tema (ex.: rss, internet-mail, text-html) ou carregue um arquivo próprio."
msgstr "בחר אחת מהסמלים למעלה, הקלד שם של כל סמל מהתמה (למשל: rss, internet-mail, text-html) או טען קובץ משלי."

#: contents/ui/main.qml
msgid "tempo esgotado"
msgstr "תם הזמן"

#: contents/ui/main.qml
msgid "falha de conexão"
msgstr "כשל חיבור"

#: contents/ui/main.qml
msgid "resposta inválida (não é RSS) ou servidor inacessível"
msgstr "תגובה לא תקפה (לא RSS) או שרת לא נגיש"

#: contents/ui/main.qml
msgid "HTTP %1"
msgstr "HTTP %1"

#: contents/ui/main.qml
msgid "%1 — %2"
msgstr "%1 — %2"

#: contents/ui/main.qml
msgid "Falha em %1 (%2)"
msgstr "כשל ב-%1 (%2)"

#: contents/ui/main.qml
msgid "Atualizar notícias"
msgstr "עדכן חדשות"

#: contents/ui/main.qml
msgid "Nenhum feed configurado"
msgstr "לא הוגדר ערוץ"

#: contents/ui/main.qml
msgid "Nenhuma notícia encontrada"
msgstr "לא נמצאו חדשות"

#: contents/ui/main.qml
msgid "Nenhuma notícia carregada. Veja os detalhes abaixo."
msgstr "לא נטענו חדשות. ראה פרטים למטה."

#: contents/ui/main.qml
msgid "Adicionar feed…"
msgstr "הוסף ערוץ…"

#: contents/ui/main.qml
msgid "Tentar novamente"
msgstr "נסה שוב"

#: contents/ui/main.qml
msgid "Alguns feeds não carregaram:"
msgstr "חלק מהערוצים לא נטענו:"

#: contents/ui/main.qml
msgid "Atualizado às %1"
msgstr "עודכן ב-%1"

#: <saudacao dinamica>
msgid "Bom dia"
msgstr "בוקר טוב"

#: <saudacao dinamica>
msgid "Boa tarde"
msgstr "צהריים טובים"

#: <saudacao dinamica>
msgid "Boa noite"
msgstr "ערב טוב"

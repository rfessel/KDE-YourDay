msgid "Informe uma URL válida (ex.: https://exemplo.com/feed.xml)."
msgstr "Geben Sie eine gültige URL ein (z. B. https://beispiel.com/feed.xml)."

#: contents/ui/configGeneral.qml
msgid "Esse feed já foi adicionado."
msgstr "Dieser Feed wurde bereits hinzugefügt."

#: contents/ui/configGeneral.qml
msgid "Adicionar feed RSS"
msgstr "RSS-Feed hinzufügen"

#: contents/ui/configGeneral.qml
msgid "URL do feed (RSS ou Atom)…"
msgstr "Feed-URL (RSS oder Atom)…"

#: contents/ui/configGeneral.qml
msgid "Limpar"
msgstr "Leeren"

#: contents/ui/configGeneral.qml
msgid "Adicionar"
msgstr "Hinzufügen"

#: contents/ui/configGeneral.qml

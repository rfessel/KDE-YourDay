#: contents/ui/configView.qml
msgid "Colunas de notícias:"
msgstr "Colonne di notizie:"

#: contents/ui/configView.qml
msgid "colunas no widget"
msgstr "colonne nel widget"

#: contents/ui/configView.qml
msgid "Com mais de 1 coluna, as notícias são distribuídas automaticamente entre as colunas."
msgstr "Con più di 1 colonna, le notizie vengono distribuite automaticamente tra le colonne."

#: contents/ui/configView.qml
msgid "Este limite vale para a lista inteira, somando todos os feeds. Para ajustar cada fonte individualmente, use a seção “Feeds de notícias”."
msgstr "Questo limite vale per l'intero elenco, sommando tutti i feed. Per regolare ogni fonte singolarmente, usa la sezione «Feed di notizie»."

#: contents/ui/configView.qml
msgid "As alterações são aplicadas imediatamente ao widget."
msgstr "Le modifiche vengono applicate immediatamente al widget."

#: contents/ui/configView.qml
msgid "Ícone do widget"
msgstr "Icona del widget"

#: contents/ui/configView.qml
msgid "Este ícone aparece na barra de tarefas e no próprio widget."
msgstr "Questa icona appare nella barra delle applicazioni e nel widget stesso."

#: contents/ui/configView.qml
msgid "Usar padrão"
msgstr "Usa quello predefinito"

#: contents/ui/configView.qml
msgid "Carregar arquivo próprio…"
msgstr "Carica un file personale…"

#: contents/ui/configView.qml
msgid "Use uma imagem (PNG, SVG, JPG…) do seu computador como ícone."
msgstr "Usa un'immagine (PNG, SVG, JPG…) del tuo computer come icona."

#: contents/ui/configView.qml
msgid "Ícone próprio em uso:\n%1"
msgstr "Icona personale in uso:\n%1"

#: contents/ui/configView.qml
msgid "Remover arquivo"
msgstr "Rimuovi file"

#: contents/ui/configView.qml
msgid "Digite o nome de um ícone…"
msgstr "Digita il nome di un'icona…"

#: contents/ui/configView.qml
msgid "Escolha um dos ícones acima, digite o nome de qualquer ícone do tema (ex.: rss, internet-mail, text-html) ou carregue um arquivo próprio."
msgstr "Scegli una delle icone sopra, digita il nome di qualsiasi icona del tema (es.: rss, internet-mail, text-html) oppure carica un file personale."


#: contents/ui/configGeneral.qml
msgid "notícias"
msgstr "notizie"

#: contents/ui/configGeneral.qml
msgid "O limite total de notícias da lista está na seção “Exibição”. As alterações são aplicadas imediatamente."
msgstr "Il limite totale delle notizie dell'elenco si trova nella sezione «Visualizzazione». Le modifiche vengono applicate immediatamente."

#: contents/ui/configView.qml
msgid "Escolher ícone"
msgstr "Scegli icona"

#: contents/ui/configView.qml
msgid "Imagens (*.png *.jpg *.jpeg *.svg *.webp *.bmp)"
msgstr "Immagini (*.png *.jpg *.jpeg *.svg *.webp *.bmp)"

#: contents/ui/configView.qml
msgid "Todos os arquivos (*)"
msgstr "Tutti i file (*)"

#: contents/ui/configView.qml
msgid "Exibição"
msgstr "Visualizzazione"

#: contents/ui/configView.qml
msgid "Máximo total de notícias na lista:"
msgstr "Massimo totale di notizie nell'elenco:"


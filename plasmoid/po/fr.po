#: contents/ui/configGeneral.qml
msgid "Informe uma URL válida (ex.: https://exemplo.com/feed.xml)."
msgstr "Saisissez une URL valide (ex. : https://exemple.com/feed.xml)."

#: contents/ui/configGeneral.qml
msgid "Esse feed já foi adicionado."
msgstr "Ce flux a déjà été ajouté."

#: contents/ui/configGeneral.qml
msgid "Adicionar feed RSS"
msgstr "Ajouter un flux RSS"

#: contents/ui/configGeneral.qml
msgid "URL do feed (RSS ou Atom)…"
msgstr "URL du flux (RSS ou Atom)…"

#: contents/ui/configGeneral.qml
msgid "Limpar"
msgstr "Effacer"

#: contents/ui/configGeneral.qml
msgid "Adicionar"
msgstr "Ajouter"

#: contents/ui/configGeneral.qml

msgid "Nenhuma notícia carregada. Veja os detalhes abaixo."
msgstr "Aucune actualité chargée. Voir les détails ci-dessous."

#: contents/ui/main.qml
msgid "Adicionar feed…"
msgstr "Ajouter un flux…"

#: contents/ui/main.qml
msgid "Tentar novamente"
msgstr "Réessayer"

#: contents/ui/main.qml

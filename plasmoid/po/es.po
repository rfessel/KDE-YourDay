#: contents/ui/configGeneral.qml
msgid "O limite total de notícias da lista está na seção “Exibição”. As alterações são aplicadas imediatamente."
msgstr "El límite total de noticias de la lista está en la sección «Exhibición». Los cambios se aplican inmediatamente."

#: contents/ui/configView.qml
msgid "Escolher ícone"
msgstr "Elegir icono"

#: contents/ui/configView.qml
msgid "Imagens (*.png *.jpg *.jpeg *.svg *.webp *.bmp)"
msgstr "Imágenes (*.png *.jpg *.jpeg *.svg *.webp *.bmp)"

